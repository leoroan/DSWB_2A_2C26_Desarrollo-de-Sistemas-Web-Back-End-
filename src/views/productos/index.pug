extends ../layout

block content
  div.d-flex.justify-content-between.align-items-center.mb-4
    div
      h1.mb-1 Productos
      p.text-muted.mb-0 Catálogo de productos para los pedidos.
    a.btn.btn-primary.shadow-sm.rounded-pill.px-4.py-2(href="/productos/nuevo")
      i.fa-solid.fa-plus.me-2
      | Nuevo producto

  if productos && productos.length > 0
    div.card.border-0.shadow-sm.overflow-hidden
      div.table-responsive
        table.table.table-hover.align-middle.mb-0
          thead.bg-light.text-uppercase.small.fw-semibold.text-secondary
            tr
              th(scope="col" class="ps-3") Producto
              th(scope="col") Categoría
              th(scope="col") Precio
              th(scope="col") Estado
              th(scope="col" class="text-end pe-3") Acción
          tbody
            each producto in productos
              tr
                td(class="ps-3 fw-semibold")= producto.nombre
                td= producto.categoria
                td $#{producto.precio}
                td
                  if producto.estado === 'activo'
                    span.badge.bg-success-subtle.text-success.border.border-success-subtle.rounded-pill.px-2.py-1.fw-medium
                      i.fa-solid.fa-circle-check.me-1
                      | activo
                  else
                    span.badge.bg-secondary-subtle.text-secondary.border.border-secondary-subtle.rounded-pill.px-2.py-1.fw-medium
                      | inactivo
                td(class="text-end pe-3")
                  a.btn.btn-sm.btn-outline-warning(href=`/productos/${producto.id}/editar` title="Editar")
                    i.fa-solid.fa-pen
                    |  Editar
  else
    div.card.border-0.shadow-sm.bg-white
      div.card-body.text-center.py-5
        i.fa-solid.fa-box-open.fa-3x.text-muted.opacity-50.mb-3
        h4.fw-normal.text-dark No hay productos registrados
        p.text-muted.mb-4 Empezá creando tu primer producto.
        a.btn.btn-primary.rounded-pill.px-4(href="/productos/nuevo") Crear ahora
