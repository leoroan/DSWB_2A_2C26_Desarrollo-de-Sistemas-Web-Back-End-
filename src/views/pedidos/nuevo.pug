extends ../layout

block content
  // Header
  div.d-flex.justify-content-between.align-items-center.mb-4
    h3.fw-bold.text-dark
      i.fa-solid.fa-cart-plus.text-info.me-2
      | Nuevo pedido
    a.btn.btn-outline-secondary.btn-sm(href="/pedidos")
      i.fa-solid.fa-arrow-left.me-1
      | Volver

  //- ===== Botón volver al inicio =====
    .mb-3
      a.btn.btn-sm.btn-outline-secondary(href="/")
        i.fa-solid.fa-arrow-left.me-1
        | Volver al inicio

  if (typeof errores !== "undefined" && errores.length > 0)
    div.alert.alert-danger
      strong
        i.fa-solid.fa-circle-exclamation.me-1
        | Se encontraron errores:
      ul.mb-0
        each error in errores
          li #{error}

  div.row.justify-content-center
    div.col-lg-8
      div.card.shadow-sm.border-0
        div.card-header.bg-primary.text-white
          h6.mb-0
            i.fa-solid.fa-pen.me-2
            if typeof modoEdicion !== "undefined" && modoEdicion
              | Editar pedido #{pedido ? "#" + pedido.id : ""}
            else
              | Datos del pedido (se crea en pendiente)
        div.card-body
          form(method="POST" action=(typeof modoEdicion !== "undefined" && modoEdicion && typeof pedido !== "undefined" ? `/pedidos/${pedido.id}/editar` : "/pedidos"))
            div.row
              div.col-md-12.mb-3
                label.form-label.fw-bold
                  i.fa-solid.fa-user.me-1.text-secondary
                  | Cliente
                  span.text-danger *
                if typeof modoEdicion !== "undefined" && modoEdicion
                  input.form-control(type="text" readonly value=(pedido && pedido.cliente ? pedido.cliente.nombre : form.clienteId))
                  small.text-muted El cliente no se cambia por reglas de negocio.
                else
                  select.form-select(name="clienteId" required)
                    option(value="") Seleccione un cliente...
                    each cliente in clientes
                      option(
                        value=cliente.id
                        selected=(typeof form !== "undefined" && String(form.clienteId) === String(cliente.id))
                      ) #{cliente.nombre} (#{cliente.estado})
              div.col-md-6.mb-3
                label.form-label.fw-bold
                  i.fa-solid.fa-calendar-day.me-1.text-secondary
                  | Fecha del pedido
                input.form-control(
                  type="date"
                  name="fechaPedido"
                  value=(typeof form !== "undefined" && form.fechaPedido ? form.fechaPedido : "")
                )
              div.col-md-6.mb-3
                label.form-label.fw-bold
                  i.fa-solid.fa-calendar-week.me-1.text-secondary
                  | Fecha de entrega solicitada
                  span.text-danger *
                input.form-control(
                  type="date"
                  name="fechaEntregaSolicitada"
                  required
                  value=(typeof form !== "undefined" && form.fechaEntregaSolicitada ? form.fechaEntregaSolicitada : "")
                )
              div.col-md-12.mb-3
                label.form-label.fw-bold
                  i.fa-solid.fa-note-sticky.me-1.text-secondary
                  | Observaciones
                textarea.form-control(
                  name="observaciones"
                  rows="2"
                  placeholder="Observaciones (opcional)"
                ) #{typeof form !== "undefined" ? form.observaciones || "" : ""}
            hr.my-3.opacity-25
            if typeof modoEdicion !== "undefined" && modoEdicion
              div.text-end
                a.btn.btn-outline-secondary.me-2(href=`/pedidos/${pedido.id}`) Cancelar
                button.btn.btn-primary(type="submit")
                  i.fa-solid.fa-floppy-disk.me-1
                  | Guardar cambios
            else
              h6.fw-bold.mb-3
                i.fa-solid.fa-list-ul.me-2.text-primary
                | Primer producto (obligatorio)
            div.row
              if typeof modoEdicion === "undefined" || !modoEdicion
                div.col-md-6.mb-3
                  label.form-label.fw-bold
                    | Producto
                    span.text-danger *
                  select.form-select(name="productoId" required)
                    option(value="") Seleccione un producto...
                    each producto in productos
                      option(
                        value=producto.id
                        selected=(typeof form !== "undefined" && String(form.productoId) === String(producto.id))
                      ) #{producto.nombre} (#{producto.estado})
                div.col-md-3.mb-3
                  label.form-label.fw-bold
                    | Cantidad
                    span.text-danger *
                  input.form-control(
                    type="number"
                    name="cantidad"
                    min="1"
                    step="1"
                    required
                    value=(typeof form !== "undefined" && form.cantidad ? form.cantidad : "")
                  )
                div.col-md-3.mb-3
                  label.form-label.fw-bold
                    | Obs. ítem
                  input.form-control(
                    type="text"
                    name="observacionItem"
                    placeholder="Opcional"
                    value=(typeof form !== "undefined" && form.observacionItem ? form.observacionItem : "")
                  )
            if typeof modoEdicion === "undefined" || !modoEdicion
              div.text-end
                a.btn.btn-outline-secondary.me-2(href="/pedidos") Cancelar
                button.btn.btn-primary(type="submit")
                  i.fa-solid.fa-floppy-disk.me-1
                  | Crear pedido
