extends ../layout

block content
  include ../includes/_spinner

  // Header con navegación contextual
  div.d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3.mb-4
    
    div.d-flex.align-items-center.gap-3
      a.btn.btn-outline-secondary.rounded-circle.p-2(href="/pedidos", title="Volver al listado")
        i.fa-solid.fa-arrow-left
      
      div
        h1.fw-bold.fs-2.text-dark.mb-0 Pedido ##{pedido.id}
        p.text-muted.fs-6.mt-1 Detalle completo y gestión logística.

    //- Badge de Estado destacado en el header
    - let badgeClass = 'bg-secondary-subtle text-secondary border-secondary-subtle';
    - let iconClass = 'fa-circle-question';
    
    if pedido.estado === 'Pendiente'
      - badgeClass = 'bg-warning-subtle text-warning-emitter border-warning-subtle';
      - iconClass = 'fa-clock';
    else if pedido.estado === 'En Proceso' || pedido.estado === 'Preparando'
      - badgeClass = 'bg-info-subtle text-info-emitter border-info-subtle';
      - iconClass = 'fa-box-open';
    else if pedido.estado === 'Enviado' || pedido.estado === 'Transporte'
      - badgeClass = 'bg-primary-subtle text-primary border-primary-subtle';
      - iconClass = 'fa-truck-fast';
    else if pedido.estado === 'Entregado' || pedido.estado === 'Completado'
      - badgeClass = 'bg-success-subtle text-success border-success-subtle';
      - iconClass = 'fa-check-double';
    else if pedido.estado === 'Cancelado'
      - badgeClass = 'bg-danger-subtle text-danger border-danger-subtle';
      - iconClass = 'fa-ban';

    span.badge.rounded-pill.px-3.py-2.fw-medium.fs-6(class=badgeClass)
      i.fa-solid(iconClass + '.me-2')
      = pedido.estado.toUpperCase()

  // Resumen Rápido (Cards superiores)
  .row.g-3.mb-4
    .col-12.col-md-4
      .card.border-0.shadow-sm.h-100
        .card-body
          h6.card-title.text-uppercase.small.fw-semibold.text-secondary.mb-3 Información General
          dl.row.mb-0.small
            dt.col-5.text-muted Fecha Pedido
            dd.col-7.text-end.fw-medium 
              if pedido.fechaPedido
                = new Date(pedido.fechaPedido).toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: 'numeric' })
              else
                span.text-danger Inválida
            
            hr.my-2.opacity-25
            
            dt.col-5.text-muted Entrega Prevista
            dd.col-7.text-end.fw-medium
              if pedido.fechaEntregaSolicitada
                = new Date(pedido.fechaEntregaSolicitada).toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: 'numeric' })
              else
                span.text-muted A confirmar

            hr.my-2.opacity-25

            dt.col-5.text-muted Observaciones
            dd.col-7.text-end.text-wrap(style="max-height: 60px; overflow-y:auto; font-size: 0.85rem;")
              = pedido.observaciones || 'Ninguna'

            if pedido.estado !== 'cancelado' && pedido.estado !== 'entregado' && pedido.estado !== 'en_reparto'
              hr.my-2.opacity-25
              div.col-12.text-end
                a.btn.btn-sm.btn-outline-secondary(href=`/pedidos/${pedido.id}/editar`)
                  i.fa-solid.fa-pen.me-1
                  | Editar

    .col-12.col-md-4
      .card.border-0.shadow-sm.h-100
        .card-body
          h6.card-title.text-uppercase.small.fw-semibold.text-secondary.mb-3 Datos del Cliente
          if pedido.cliente
            div.d-flex.align-items-start.gap-2
              div.bg-light.rounded-circle.p-2
                i.fa-solid.fa-user.text-secondary
              div
                h5.mb-0.fw-semibold #{pedido.cliente.nombre} #{pedido.cliente.apellido || ''}
                p.mb-1.small.text-muted= pedido.cliente.email
                p.mb-0.small.text-muted
                  i.fa-solid.fa-phone.me-1
                  = pedido.cliente.telefono || 'Sin teléfono'
          else
            div.alert.alert-warning.mb-0.py-2.px-3.small
              i.fa-solid.fa-exclamation-triangle.me-2
              strong Cliente no encontrado.
              br
              | ID Referencia: #{pedido.clienteId}

    .col-12.col-md-4
      .card.border-0.shadow-sm.h-100.bg-light-subtle
        .card-body
          h6.card-title.text-uppercase.small.fw-semibold.text-secondary.mb-3 Logística & Ruta
          
          if pedido.ruta
            div.mb-3
              span.badge.bg-primary.text-white.rounded-pill.px-2.py-1
                i.fa-solid.fa-route.me-1
                = pedido.ruta.nombre
              small.d-block.mt-2.text-muted
                | Asignado correctamente.
          else
            div.mb-3
              span.badge.bg-light.text-dark.border.rounded-pill.px-2.py-1
                i.fa-solid.fa-unlink.me-1
                | Sin ruta asignada
              small.d-block.mt-2.text-muted
                | Requiere asignación manual.

          // Formulario rápido de asignación integrado en la card
          form(method='post' action=`/pedidos/${pedido.id}/ruta` data-spinner)
            label.form-label.small.fw-medium(for='rutaId') Cambiar/Asignar Ruta
            select.form-select.form-select-sm#rutaId(name='rutaId')
              option(value='' selected=!pedido.ruta) -- Elegir ruta --
              each ruta in rutas
                option(value=ruta.id selected=pedido.ruta && pedido.ruta.id === ruta.id)= ruta.nombre
            
            button.btn.btn-primary.btn-sm.w-100.mt-2(type='submit')
              i.fa-solid.fa-save.me-1
              | Guardar Asignación

  // Tabla de Productos
  div.card.border-0.shadow-sm.overflow-hidden
    div.card-header.bg-white.border-bottom.py-3
      h5.card-title.mb-0.fw-semibold
        i.fa-solid.fa-list-ul.me-2.text-primary
        | Ítems del Pedido
        
    div.table-responsive
      table.table.table-hover.align-middle.mb-0
        thead.bg-light.text-uppercase.small.fw-semibold.text-secondary
          tr
            th(scope="col", class="ps-3") Producto
            th(scope="col" class="text-center") Cant.
            th(scope="col") Detalles / Obs.
            th(scope="col" class="text-end pe-3") Acción
        
        tbody
          if pedido.items && pedido.items.length > 0
            each item in pedido.items
              tr
                td(class="ps-3 fw-medium")
                  = item.producto ? item.producto.nombre : 'Producto desconocido'
                
                td(class="text-center")
                  span.badge.bg-light.text-dark.border.rounded-pill.min-w-0.px-2.py-1
                    = item.cantidad
                
                td(class="small text-muted")
                  = item.observaciones || '-'

                td(class="text-end pe-3")
                  if pedido.estado === 'en_preparacion'
                    a.btn.btn-sm.btn-outline-warning.me-1(href=`/pedidos/${pedido.id}?editarItem=${item.id}` title="Cambiar producto, cantidad u observación")
                      i.fa-solid.fa-pen
                      |  Cambiar
                    if pedido.items.length > 1
                      form(method='post' action=`/pedidos/${pedido.id}/items/${item.id}/eliminar` style="display:inline")
                        button.btn.btn-sm.btn-outline-danger(type='submit' title="Quitar ítem")
                          i.fa-solid.fa-trash-can
                          |  Quitar
                  else
                    span.text-muted -
          else
            tr
              td(colspan="4" class="text-center py-4")
                div.text-muted
                  i.fa-solid.fa-inbox.fa-2x.mb-2.opacity-50
                  p.mb-0 Este pedido aún no contiene productos asociados.

  // Alta / edición de ítems (paso 2)
  div.card.border-0.shadow-sm.mt-3
    div.card-header.bg-white.border-bottom.py-3
      h5.card-title.mb-0.fw-semibold
        if typeof itemEditar !== "undefined" && itemEditar
          i.fa-solid.fa-pen.me-2.text-warning
          | Cambiar producto del pedido
        else
          i.fa-solid.fa-plus.me-2.text-primary
          | Agregar producto
    div.card-body
      if !pedido.items || pedido.items.length === 0
        div.alert.alert-warning.mb-3
          i.fa-solid.fa-triangle-exclamation.me-2
          | Este pedido aún no es válido: agregá al menos un producto.
      if pedido.estado === 'en_preparacion'
        if typeof itemEditar !== "undefined" && itemEditar
          form(method='post' action=`/pedidos/${pedido.id}/items/${itemEditar.id}` data-spinner)
            .row.g-2.align-items-end
              .col-12.col-md-5
                label.form-label.small.fw-semibold.text-secondary(for='productoId') Producto
                select.form-select.form-select-sm#productoId(name='productoId' required)
                  each producto in productos
                    option(value=producto.id selected=String(producto.id) === String(itemEditar.productoId)) #{producto.nombre} (#{producto.estado})
              .col-6.col-md-3
                label.form-label.small.fw-semibold.text-secondary(for='cantidad') Cantidad
                input.form-control.form-control-sm#cantidad(type='number' name='cantidad' min='1' step='1' required value=itemEditar.cantidad)
              .col-12.col-md-4
                label.form-label.small.fw-semibold.text-secondary(for='observaciones') Obs. del producto
                input.form-control.form-control-sm#observaciones(type='text' name='observaciones' placeholder='Opcional' value=itemEditar.observaciones)
            div.mt-2
              button.btn.btn-warning.btn-sm(type='submit')
                i.fa-solid.fa-floppy-disk.me-1
                | Guardar cambios
              a.btn.btn-outline-secondary.btn-sm.ms-2(href=`/pedidos/${pedido.id}`) Cancelar
        else
          form(method='post' action=`/pedidos/${pedido.id}/items` data-spinner)
            .row.g-2.align-items-end
              .col-12.col-md-5
                label.form-label.small.fw-semibold.text-secondary(for='productoId') Producto
                select.form-select.form-select-sm#productoId(name='productoId' required)
                  option(value='') -- Elegir producto --
                  each producto in productos
                    option(value=producto.id) #{producto.nombre} (#{producto.estado})
              .col-6.col-md-3
                label.form-label.small.fw-semibold.text-secondary(for='cantidad') Cantidad
                input.form-control.form-control-sm#cantidad(type='number' name='cantidad' min='1' step='1' required)
              .col-12.col-md-4
                label.form-label.small.fw-semibold.text-secondary(for='observaciones') Obs. del producto
                input.form-control.form-control-sm#observaciones(type='text' name='observaciones' placeholder='Ej: sin sal, bien frío...' value=(typeof itemEditar !== "undefined" && itemEditar ? itemEditar.observaciones : ""))
            div.mt-2
              button.btn.btn-primary.btn-sm(type='submit')
                i.fa-solid.fa-plus.me-1
                | Agregar al pedido
      else
        div.alert.alert-info.mb-0.d-flex.align-items-center.gap-2(role="alert")
          i.fa-solid.fa-circle-info.fs-5.flex-shrink-0
          div
            strong Regla de negocio —
            |  un pedido solo puede agregar o modificar productos cuando está
            span.badge.text-bg-info en preparación
            | . Estado actual:
            span.badge.text-bg-secondary= pedido.estado
            | .

  // Spinner global mientras se envía un formulario
  div#spinnerGlobal.d-none
    +spinnerToast("Guardando cambios...")

  script.
    document.querySelectorAll('form[data-spinner]').forEach(function (form) {
      form.addEventListener('submit', function () {
        var overlay = document.getElementById('spinnerGlobal');
        if (overlay) overlay.classList.remove('d-none');
        var btn = form.querySelector('button[type="submit"]');
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Procesando...';
        }
      });
    });
