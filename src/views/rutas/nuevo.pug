extends ../layout

block content
  div.d-flex.justify-content-between.align-items-center.mb-4
    h3.fw-bold.text-dark
      i.fa-solid.fa-route.text-info.me-2
      | Nueva ruta
    a.btn.btn-outline-secondary.btn-sm(href="/rutas")
      i.fa-solid.fa-arrow-left.me-1
      | Volver

  if (typeof errores !== "undefined" && errores.length > 0)
    div.alert.alert-danger
      strong
        i.fa-solid.fa-circle-exclamation.me-1
        | Se encontraron errores:
      ul.mb-0
        each error in errores
          li #{error}

  div.row.justify-content-center
    div.col-lg-8
      div.card.shadow-sm.border-0
        div.card-header.bg-primary.text-white
          h6.mb-0
            i.fa-solid.fa-pen.me-2
            | Datos de la ruta (simple)
        div.card-body
          form(method="POST" action="/rutas")
            div.row
              div.col-md-6.mb-3
                label.form-label.fw-bold
                  | Código
                  span.text-danger *
                input.form-control(type="text" name="codigo" required placeholder="RUT-2026-005" value=(typeof form !== "undefined" && form.codigo ? form.codigo : ""))
              div.col-md-6.mb-3
                label.form-label.fw-bold
                  | Chofer disponible
                  span.text-danger *
                select.form-select(name="choferId" required)
                  option(value="") Seleccione un chofer...
                  each chofer in choferes
                    option(value=chofer.id selected=(typeof form !== "undefined" && String(form.choferId) === String(chofer.id))) #{chofer.nombre} #{chofer.apellido || ""} (#{chofer.estado})
              div.col-md-6.mb-3
                label.form-label.fw-bold
                  | Vehículo
                select.form-select(name="vehiculoPatente")
                  option(value="") Sin asignar...
                  each vehiculo in vehiculos
                    option(value=vehiculo.patente selected=(typeof form !== "undefined" && form.vehiculoPatente === vehiculo.patente)) #{vehiculo.patente} (#{vehiculo.estado})
              div.col-md-6.mb-3
                label.form-label.fw-bold
                  | Fecha de planificación
                input.form-control(type="datetime-local" name="fechaPlanificacion" value=(typeof form !== "undefined" && form.fechaPlanificacion ? form.fechaPlanificacion : ""))
              div.col-md-12.mb-3
                label.form-label.fw-bold
                  | Observaciones
                textarea.form-control(name="observaciones" rows="2" placeholder="Opcional") #{typeof form !== "undefined" ? form.observaciones || "" : ""}
            div.text-end
              a.btn.btn-outline-secondary.me-2(href="/rutas") Cancelar
              button.btn.btn-primary(type="submit")
                i.fa-solid.fa-floppy-disk.me-1
                | Crear ruta
