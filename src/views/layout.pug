doctype html
html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title #{titulo || "FreshRoute B2B - Distribución Inteligente"}
    // Bootstrap 5 CSS CDN
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
    // FontAwesome Icons CDN
    link(href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet")
    style.
      body {
        background-color: #f8f9fa;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .navbar-brand {
        font-weight: 700;
        letter-spacing: 0.5px;
      }
      .cold-alert {
        animation: blinker 2s linear infinite;
      }
      @keyframes blinker {
        50% { opacity: 0.5; }
      }
      footer {
        margin-top: auto;
      }
  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.shadow-sm
      div.container
        a.navbar-brand(href="/")
          i.fa-solid.fa-truck-ramp-box.me-2.text-info
          span FRESH
          span.text-info ROUTE
          span.ms-1.badge.bg-secondary.text-uppercase.small(style="font-size: 0.6em") B2B Logística
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation")
          span.navbar-toggler-icon
        div.collapse.navbar-collapse#navbarNav
          ul.navbar-nav.ms-auto
            li.nav-item
              a.nav-link(href="/") 
                i.fa-solid.fa-chart-line.me-1
                | Dashboard (Oficina)
            li.nav-item
              a.nav-link(href="/simulador") 
                i.fa-solid.fa-mobile-screen-button.me-1
                | Simulador Chofer
            li.nav-item
              a.nav-link(href="/documentacion") 
                i.fa-solid.fa-book.me-1
                | Entrega Académica (ISFT 29)

    main.container.my-4
      block content

    footer.bg-dark.text-white.py-3.text-center.border-top.border-secondary
      div.container
        p.mb-1.small
          | © 2026 FreshRoute B2B S.A. – Todos los derechos reservados.
        p.mb-0.text-muted.small(style="font-size: 0.8em")
          | Desarrollo de Sistemas Web (Back End) - 2° A 2C2026 | ISFT N° 29 "Lean"

    // Bootstrap 5 JS Bundle CDN
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")