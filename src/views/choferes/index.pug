extends ../layout

block content
  div.d-flex.justify-content-between.align-items-center.mb-4
    div
      h1.mb-1 Chóferes de la Flota
      p.text-muted.mb-0 Personal de reparto registrado en MongoDB FreshRoute.

    div
      a.btn.btn-outline-secondary.me-2(href="/")
        i.fa-solid.fa-house.me-1
        | Panel Principal
      a.btn.btn-primary(href="/choferes/nuevo")
        i.fa-solid.fa-user-plus.me-2
        | Registrar nuevo chófer

  if creado
    div.alert.alert-success.alert-dismissible.fade.show(role="alert")
      i.fa-solid.fa-circle-check.me-2
      strong ¡Éxito!
      span  El chófer fue registrado y guardado exitosamente en la base de datos MongoDB.
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

  if choferes && choferes.length
    div.table-responsive
      table.table.table-striped.table-hover.align-middle
        thead.table-dark
          tr
            th ID
            th Nombre y Apellido
            th Edad
            th Licencia
            th Correo Electrónico
            th Vehículo Asignado
            th Estado
            th Fecha Alta
        tbody
          each chofer in choferes
            tr
              td.fw-bold= chofer.id
              td= `${chofer.nombre || ''} ${chofer.apellido || ''}`
              td= chofer.edad ? `${chofer.edad} años` : '-'
              td
                span.badge.bg-dark= chofer.licencia || 'B2'
              td= chofer.email || '-'
              td
                if chofer.vehiculoId && vehiculosPorId.get(chofer.vehiculoId)
                  - const v = vehiculosPorId.get(chofer.vehiculoId)
                  span.badge.bg-info.text-dark= `Patente ${v.patente} (${v.tipo})`
                else
                  span.text-muted Sin vehículo
              td
                if chofer.estado === "Disponible" || chofer.estado === "activo"
                  span.badge.bg-success= chofer.estado
                else if chofer.estado === "En Viaje"
                  span.badge.bg-primary= chofer.estado
                else
                  span.badge.bg-secondary= chofer.estado || 'Activo'
              td.small.text-muted= chofer.fechaAlta || '-'
  else
    div.alert.alert-info
      i.fa-solid.fa-circle-info.me-2
      | No hay chóferes registrados en la base de datos.
