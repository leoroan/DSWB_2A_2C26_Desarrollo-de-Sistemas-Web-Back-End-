extends ../layout

block content
  //- ===== Breadcrumb =====
  nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.shadow-sm.mb-4.rounded
    div.container
      a.navbar-brand(href="/remitos" style="font-size:1.05rem")
        i.fa-solid.fa-arrow-left.me-2
        | Volver a Remitos

  //- ===== Header del Remito =====
  div.card.shadow-sm.border-0.mb-4
    div.card-header.bg-primary-subtle.border-0.d-flex.justify-content-between.align-items-center
      h5.mb-0.text-primary.fw-semibold
        i.fa-solid.fa-file-invoice.me-2
        | Información del Remito
      span.badge.bg-white.text-primary.border.border-primary-subtle
        i.fa-solid.fa-hashtag.me-1
        | #{remito.id}
    div.card-body.p-4
      div.row.g-4
        div.col-md-6.col-xl-3
          div.text-muted.small.fw-semibold.mb-1
            i.fa-regular.fa-calendar-circle-plus.me-1
            | Número
          div.fs-4.font-monospace.fw-bold
            | REM-#{String(remito.id).padStart(4, '0')}
        div.col-md-6.col-xl-3
          div.text-muted.small.fw-semibold.mb-1
            i.fa-solid.fa-truck-square.me-1
            | Pedido
          div.fs-4.font-monospace.fw-bold
            if remito.pedidoId
              | #{remito.pedidoId}
            else
              span.text-muted Sin pedido asociado
        div.col-md-6.col-xl-3
          div.text-muted.small.fw-semibold.mb-1
            i.fa-solid.fa-handshake.me-1
            | Cliente
          div.fs-4.font-monospace
            if remito.cliente
              | #{remito.cliente}
            else
              span.text-muted No especificado
        div.col-md-6.col-xl-3
          div.text-muted.small.fw-semibold.mb-1
            i.fa-regular.fa-calendar-circle-plus.me-1
            | Fecha de Emisión
          div.fs-5.font-monospace
            | #{remito.fechaEmision}
      hr.my-4
      div.row.g-4
        div.col-md-6.col-xl-3
          div.text-muted.small.fw-semibold.mb-1
            i.fa-regular.fa-calendar-circle-exclamation.me-1
            | Fecha de Vencimiento
          div.fs-5.font-monospace
            | #{remito.fechaVencimiento}
        div.col-md-6.col-xl-3
          div.text-muted.small.fw-semibold.mb-1
            i.fa-solid.fa-scale-balanced.me-1
            | Monto Total
          div.fs-4.font-monospace.fw-bold.text-success
            | $#{remito.montoTotal.toFixed(2)}
        div.col-md-6.col-xl-3
          div.text-muted.small.fw-semibold.mb-1
            i.fa-regular.fa-building-circle-check.me-1
            | Estado
          div
            case remito.estado
              when 'firmado'
                span.badge.rounded-pill.bg-success
                  i.fa-solid.fa-check-circle.me-1
                  | Firmado
              when 'pendiente'
                span.badge.rounded-pill.bg-warning.text-dark
                  i.fa-solid.fa-clock.me-1
                  | Pendiente
              when 'vencido'
                span.badge.rounded-pill.bg-danger
                  i.fa-solid.fa-exclamation-triangle.me-1
                  | Vencido
              default
                span.badge.rounded-pill.bg-secondary= remito.estado

  //- ===== Datos de la Entrega =====
  div.card.shadow-sm.border-0.mb-4
    div.card-header.bg-info-subtle.border-0
      h5.mb-0.text-info-emphasis.fw-semibold
        i.fa-solid.fa-truck-fast.me-2
        | Datos de la Entrega
    div.card-body.p-4
      div.row.g-4
        div.col-md-4
          div.text-muted.small.fw-semibold.mb-2
            i.fa-regular.fa-circle-check.me-1
            | ¿Firmado?
          if remito.firmadoPor
            div.d-flex.align-items-center.gap-2
              span.badge.rounded-pill.bg-success
                i.fa-solid.fa-check-circle.me-1
                | Sí
              span.small.text-muted
                | por 
                strong.text-body #{remito.firmadoPor}
          else
            span.badge.rounded-pill.bg-warning.text-dark
              i.fa-regular.fa-file-signature.me-1
              | No firmado
        div.col-md-4
          div.text-muted.small.fw-semibold.mb-2
            i.fa-regular.fa-calendar-circle-exclamation.me-1
            | ¿Vencido?
          if remito.estaVencido()
            span.badge.rounded-pill.bg-danger
              i.fa-solid.fa-triangle-exclamation.me-1
              | Sí – Vencido
          else
            span.badge.rounded-pill.bg-success
              i.fa-solid.fa-check-circle.me-1
              | Vigente
        div.col-md-4
          div.text-muted.small.fw-semibold.mb-2
            i.fa-regular.fa-file-lines.me-1
            | ¿Es válido?
          if remito.esValido()
            span.badge.rounded-pill.bg-success
              i.fa-solid.fa-check-circle.me-1
              | Sí
          else
            span.badge.rounded-pill.bg-danger
              i.fa-solid.fa-circle-exclamation.me-1
              | No

  //- ===== Firma =====
  div.card.shadow-sm.border-0.mb-4
    div.card-header.bg-body.border-bottom
      h5.mb-0.fw-semibold
        i.fa-solid.fa-pen-nib.me-2.text-secondary
        | Firma
    div.card-body.p-4
      div.d-flex.justify-content-between.align-items-center.flex-wrap.gap-3
        div
          div.text-muted.small.fw-semibold.mb-1
            i.fa-regular.fa-user.me-1
            | Firmado por
          if remito.firmadoPor
            div.fs-4.font-monospace
              | #{remito.firmadoPor}
          else
            div.fs-5.text-muted.fst-italic
              i.fa-regular.fa-user-slash.me-1
              | Sin firmante
        div.text-end
          if remito.firmadoPor
            span.badge.bg-info-subtle.text-info-emphasis
              i.fa-regular.fa-clock.me-1
              | Firmado el #{new Date().toLocaleDateString('es-AR')}
          else
            button.btn.btn-outline-primary(type="button")
              i.fa-regular.fa-hand-rock.me-1
              | Firmar remito

  //- ===== Observaciones =====
  div.card.shadow-sm.border-0.mb-4
    div.card-header.bg-body.border-bottom
      h5.mb-0.fw-semibold
        i.fa-solid.fa-note-sticky.me-2.text-secondary
        | Observaciones
    div.card-body.p-4
      if remito.observaciones
        div.bg-body-tertiary.p-3.rounded.border
          p.mb-0.small.text-body
            | #{remito.observaciones}
      else
        div.bg-body-tertiary.p-4.rounded.border.text-center.text-muted
          i.fa-regular.fa-face-smile.fa-2x.mb-2.opacity-50
          p.small.mb-0 No hay observaciones registradas.

  //- ===== Penalización =====
  div.card.shadow-sm.border-0.mb-4
    div.card-header.bg-body.border-bottom
      h5.mb-0.fw-semibold
        i.fa-solid.fa-triangle-exclamation.me-2.text-secondary
        | Penalización
    div.card-body.p-4
      div.row.g-4
        div.col-md-6
          div.text-muted.small.fw-semibold.mb-1
            i.fa-regular.fa-circle-dollar.me-1
            | Monto de Penalización
          if remito.penalizacionAplicada && remito.penalizacionAplicada > 0
            span.badge.rounded-pill.bg-danger.fs-6
              | $#{remito.penalizacionAplicada.toFixed(2)}
          else
            span.text-success.fst-italic
              i.fa-regular.fa-circle-check.me-1
              | Sin penalización aplicada
        div.col-md-6
          div.text-muted.small.fw-semibold.mb-1
            i.fa-regular.fa-chart-line.me-1
            | Monto Total (con penalización)
          div.fs-4.font-monospace.fw-bold.text-success
            | $#{remito.montoTotal.toFixed(2)}
        div.col-12
          div.text-muted.small.fw-semibold.mb-1
            i.fa-regular.fa-circle-check.me-1
            | ¿Penalización aplicada?
          if remito.penalizacionAplicada && remito.penalizacionAplicada > 0
            span.badge.rounded-pill.bg-danger
              i.fa-solid.fa-circle-exclamation.me-1
              | Sí – $#{remito.penalizacionAplicada.toFixed(2)}
          else
            span.badge.rounded-pill.bg-success
              i.fa-solid.fa-check-circle.me-1
              | No