extends ../layout

block content
  // Header
  div.d-flex.justify-content-between.align-items-center.mb-4
    h3.fw-bold.text-dark
      i.fa-solid.fa-file-invoice.text-info.me-2
      | Remitos
    a.btn.btn-primary.btn-sm(href="/remitos/nuevo")
      i.fa-solid.fa-plus.me-1
      | Nuevo Remito

  // Tabla de Remitos
  if (remitos && remitos.length > 0)
    div.card.shadow-sm.border-0
      div.table-responsive
        table.table.table-hover.table-striped.mb-0
          thead.bg-light
            tr
              th#fdcargar.number.text-nowrap ID
              th.pedido.text-nowrap Pedido
              th.cliente.text-nowrap Cliente
              th.fecha.text-nowrap Fecha Emisión
              th.estado.text-nowrap Estado
              th.firmado.text-nowrap Firmado
              th.penalizacion.text-nowrap Penalización
              th.text-end Acciones
          tbody
            each remito in remitos
              tr
                td.font-monospace
                  strong #{remito.id}
                td
                  a(href="/remitos/" + remito.id style="text-decoration:none;color:inherit")
                    span.badge.bg-warning.text-dark #{remito.pedidoId}
                td
                  if (remito.cliente)
                    small.text-muted #{remito.cliente}
                  else
                    span.text-muted.fa-regular.fa-user
                td.text-nowrap.small.text-muted #{remito.fechaEmision}
                td
                  if (remito.estado === 'Firmado')
                    span.badge.badge-success
                      i.fa-solid.fa-check-circle.me-1
                      | Firmado
                  else if (remito.estado === 'Pendiente')
                    span.badge.badge-warning
                      i.fa-solid.fa-clock.me-1
                      | Pendiente
                  else if (remito.estado === 'Vencido')
                    span.badge.badge-danger
                      i.fa-solid.fa-exclamation-triangle.me-1
                      | Vencido
                  else
                    span.badge.bg-secondary #{remito.estado}
                td.text-center
                  if (remito.firmadoPor)
                    i.fa-solid.fa-pen-or-fountain.text-info.me-1
                    small.fw-bold #{remito.firmadoPor}
                  else
                    span.text-muted.fa-regular.fa-user-slash
                td
                  if (remito.penalizacionAplicada && remito.penalizacionAplicada > 0)
                    span.badge.bg-danger
                      i.fa-solid.fa-circle-exclamation.me-1
                      | $#{remito.penalizacionAplicada.toFixed(2)}
                  else
                    span.text-muted.fa-regular.fa-circle-check
                td.text-nowrap.text-end
                  a.btn.btn-outline-secondary.btn-sm(href="/remitos/" + remito.id)
                    i.fa-solid.fa-eye.me-1
                    | Ver
                  a.btn.btn-outline-primary.btn-sm(href="/remitos/" + remito.id + "/editar")
                    i.fa-solid.fa-pen-to-square.me-1
                  a.btn.btn-outline-danger.btn-sm(href="/remitos/" + remito.id + "/eliminar")
                    i.fa-solid.fa-trash-can.me-1
  else
    div.card.shadow-sm.border-0.text-center.py-5
      i.fa-solid.fa-box-open.fa-3x.text-muted.mb-3
      h5.text-muted No hay remitos registrados
      p.small.text-muted Aún no se han generado remitos. Comienza creando uno nuevo.
      a.btn.btn-outline-primary.btn-sm(href="/remitos/nuevo" class="mt-2")
        i.fa-solid.fa-plus.me-1
        | Crear Primer Remito
