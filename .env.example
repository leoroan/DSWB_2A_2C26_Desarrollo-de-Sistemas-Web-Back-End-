# =============================================================================
# Configuración de la aplicación FreshRoute B2B
# Copiá este archivo a ".env" y completá con tus datos reales.
# El archivo ".env" NO se sube al repositorio (ver .gitignore).
# =============================================================================

# Puerto donde corre el servidor Express.
PORT=3000

# Entorno: development | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# Base de datos MongoDB
# -----------------------------------------------------------------------------
# URI de conexión. Para MongoDB Atlas tené este formato:
#   mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net
# (Reemplazá <usuario>, <password> y la parte <cluster> por los de tu clúster.)
# Si la contraseña trae caracteres especiales (@ : / ? #), codificalos en URL.
# Ejemplo:
#   MONGODB_URI=mongodb+srv://freshroute:MiPass123@cluster0.abcd.mongodb.net
#
# Para un MongoDB local podés usar:
#   MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017

# Nombre de la base de datos dentro del clúster.
MONGODB_DB=freshroute

# Tiempo máximo de espera para conectar (ms).
MONGODB_TIMEOUT_MS=10000
